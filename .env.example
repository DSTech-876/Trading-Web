# ──────────────────────────────────────────────────────────────
# Server-side environment variables (Hostinger / your server)
# ──────────────────────────────────────────────────────────────
# 1. Copy this file to .env on your SERVER (not just locally —
#    .env is git-ignored, so it must exist on the server).
# 2. Fill in the real values below.
# 3. NEVER commit the actual .env file to version control.
# ──────────────────────────────────────────────────────────────

# Database — use the credentials from your Hostinger hPanel → Databases
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost

# Application
APP_ENV=production
# Set to true while troubleshooting; set to false once everything works
APP_DEBUG=false

# Auth API (used by auth.js on the client side)
AUTH_API_BASE=https://trading.dsitservicesja.com/api/auth

# JWT / Session secret (used server-side for token signing)
# Generate one with:  php -r "echo bin2hex(random_bytes(32));"
# If omitted, the server will auto-generate and persist one in .jwt_secret
JWT_SECRET=

# ──────────────────────────────────────────────────────────────
# Scheduled job (cron) protection
# ──────────────────────────────────────────────────────────────
# Hostinger (and similar shared hosts) only support triggering cron jobs
# by requesting a URL, not by invoking the PHP CLI directly. This secret
# key must be appended to the cron URL so the endpoint can distinguish a
# legitimate cron trigger from a random public visitor, e.g.:
#   https://yourdomain.com/cron/subscription_cron.php?key=YOUR_CRON_SECRET_KEY
# Generate one with:  php -r "echo bin2hex(random_bytes(32));"
# If omitted, the server will auto-generate and persist one in .cron_secret
CRON_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_KEY



# ──────────────────────────────────────────────────────────────
# Telegram Group Subscription Integration
# ──────────────────────────────────────────────────────────────
# Obtain a bot token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Numeric ID of the private group/channel (negative number, e.g. -1001234567890).
# Get it by adding @userinfobot to the group, or via getChat.
TELEGRAM_GROUP_CHAT_ID=

# Random secret used to validate incoming webhook requests from Telegram.
# Generate one with:  php -r "echo bin2hex(random_bytes(32));"
# Then register it with Telegram when calling setWebhook (see api/telegram/setup_webhook.php).
TELEGRAM_WEBHOOK_SECRET=

# ──────────────────────────────────────────────────────────────
# Deriv Public Market-Data WebSocket
# Used by api/lib/DerivMarketDataService.php and DerivPublicFeedService.php
# for server-side tick/candle fetching.
# No API token is required for this endpoint.
# Change only if Deriv publishes a new public WebSocket URL.
DERIV_PUBLIC_WS_URL=wss://ws.derivws.com/websockets/v3?app_id=120128

# Auto-start the public market feed when the trading dashboard loads.
# true  – feed connects automatically on page load (recommended for live use).
# false – user must press "Start Public Market Feed" manually.
AUTO_START_PUBLIC_FEED=true

# ──────────────────────────────────────────────────────────────
# MT5 Bridge Integration (optional)
# ──────────────────────────────────────────────────────────────
# Admin/operator-only secret used SOLELY by /api/mt5/audit.php for
# cross-user diagnostics. It is NOT used by pull.php/status.php anymore —
# each user authenticates those with their own personal bridge key instead
# (fetched/rotated from the web app via GET|POST /api/mt5/bridge_key.php and
# configured into that user's own ITGuruMt5Bridge.mq5 InpBridgeKey). This
# per-user key, not this shared one, is what prevents one user's auto-trade
# signal from being dispatched to another user's MT5 account.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
MT5_BRIDGE_KEY=change_me_to_a_random_secret

# Emergency kill-switch: set to true to immediately stop dispatching new/retry
# orders to all connected EAs (e.g. during an incident). In-flight order
# status callbacks still work. Leave false for normal operation.
MT5_TRADING_HALTED=false
MT5_TRADING_HALT_REASON=

# Optional symbol map (JSON object) translating internal/TradingView instrument
# codes to the broker's actual MarketWatch symbol name, e.g. when the broker
# lists Step Index 500 as "Step Index 500" instead of the shorthand "stpRNG5".
# Surfaced to the EA as `brokerSymbolHint` so ITGuruMt5Bridge.mq5's automatic
# symbol resolution can use it before falling back to its own alias/fuzzy
# MarketWatch scan. The indicator already sends a default hint for every
# synthetic index (see BROKER_SYMBOL_HINTS in indicator/indicator.js), so this
# only needs to be set when a broker uses non-standard symbol names; any entry
# configured here overrides that client-supplied default. Leave empty to rely
# entirely on the client's default hints.
# Example: MT5_SYMBOL_MAP={"stpRNG5":"Step Index 500","EURUSD":"EURUSD.m"}
MT5_SYMBOL_MAP=

# ──────────────────────────────────────────────────────────────
# Email / SMTP (transactional subscription emails)
# ──────────────────────────────────────────────────────────────
# If SMTP_HOST and MAIL_FROM are set, emails are delivered over SMTP.
# If they are left empty, the app falls back to PHP's mail() function.
#
# For Hostinger email: SMTP_HOST=smtp.hostinger.com, port 465 (ssl) or 587 (tls).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# ssl (implicit TLS, port 465) | tls (STARTTLS, port 587) | none
SMTP_SECURE=tls
SMTP_TIMEOUT=15

# From address shown to recipients (must be a mailbox you control).
MAIL_FROM=no-reply@yourdomain.com
MAIL_FROM_NAME=IT Guru Trading

# Public app URL used for links inside emails.
APP_URL=https://yourdomain.com

# ──────────────────────────────────────────────────────────────
# Subscription reminder schedule (days before expiry, comma-separated)
# Consumed by cron/subscription_cron.php.
# ──────────────────────────────────────────────────────────────
SUBSCRIPTION_REMINDER_DAYS=14,7,3,1

# ──────────────────────────────────────────────────────────────
# Quick setup checklist:
#   [ ] Created .env on the SERVER with real DB credentials
#   [ ] Ran database/schema.sql in phpMyAdmin or MySQL CLI
#   [ ] Generated a random JWT_SECRET (see command above)
#   [ ] Generated a random CRON_SECRET_KEY (see command above)
#   [ ] Visit /api/auth/status to verify everything is working
#   [ ] Set APP_DEBUG=false once registration works
#   [ ] Set TELEGRAM_BOT_TOKEN, TELEGRAM_GROUP_CHAT_ID, TELEGRAM_WEBHOOK_SECRET
#   [ ] (Optional) Set MT5_BRIDGE_KEY before enabling MT5 Bridge execution mode
#   [ ] Set SMTP_* + MAIL_FROM for subscription emails (or rely on mail())
#   [ ] Run database/migrations/2026_email_subscription_lifecycle.sql
#   [ ] Schedule cron/subscription_cron.php (see docs/SUBSCRIPTION_EMAIL_SETUP.md)
#   [ ] Run api/telegram/setup_webhook.php once to register the webhook with Telegram
# ──────────────────────────────────────────────────────────────
