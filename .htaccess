# ──────────────────────────────────────────────
# Trading-Web — Root .htaccess
# ──────────────────────────────────────────────
# URL rewriting for the PHP API + security hardening.
# Deploy this file to your Hostinger document root.
# ──────────────────────────────────────────────

RewriteEngine On

# ── Force HTTPS ──
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Block access to dotfiles (.env, .git, etc.) ──
RewriteRule (^\.|/\.) - [F,L]

# ── API URL rewriting (extensionless PHP) ──
# Maps /api/auth/login → /api/auth/login.php etc.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/auth/(login|register|verify|refresh|status)$ api/auth/$1.php [L,QSA]

# ── User profiles API URL rewriting ──
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/profiles$ api/profiles.php [L,QSA]

# ── Adaptive intelligence API URL rewriting ──
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/adaptive/(bootstrap|metrics|profiles|qualify|trades)$ api/adaptive/$1.php [L,QSA]

# ── Admin API URL rewriting ──
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/admin/layouts/(.+)$ api/admin/layouts.php?path=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/admin/(users|user|strategies|strategy_access|auth_guard|telegram|profiles|adaptive|notification_preferences|notifications|telegram_delivery_log|dashboard|preferences|audit_trail|impersonate|notifications_center|search|users_management|strategy_stats|adaptive_intelligence|logs|telegram_queue|performance|layouts|optimize-db|schema_validation)$ api/admin/$1.php [L,QSA]

# ── Telegram API URL rewriting (extensionless PHP) ──
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/telegram/(link_token|webhook|unlink|setup_webhook|request_invite|proxy|delivery_log)$ api/telegram/$1.php [L,QSA]

# ── User notification preferences API URL rewriting ──
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/notifications$ api/notifications.php [L,QSA]

# ── User notification preferences API URL rewriting ──
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/notification_preferences$ api/notification_preferences.php [L,QSA]

# ── Trade management API URL rewriting ──
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/trades/(log_outcome|check_notification|signal_history)$ api/trades/$1.php [L,QSA]

# ── Security headers ──
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── Block direct download of sensitive file types ──
<FilesMatch "\.(env|sql|sqlite|db|log|ini|sh|bak)$">
    Require all denied
</FilesMatch>
